{
  "manifest_version": 3,
  "name": "sidebar-open-close-methods",
  "description": "sidebar-open-close-methods",
  "homepage_url": "https://jeurissen.co/webext-demos/sidebar-open-close-methods",
  "author": "Carlos Jeurissen",
  "version": "0.0.3",
  "icons": {
    "16": "icon.png",
    "48": "icon.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_area": "navbar"
  },
  "options_page": "main.html",
  "options_ui": {
    "page": "main.html",
    "open_in_tab": true
  },
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_panel": "main.html"
  }
}
