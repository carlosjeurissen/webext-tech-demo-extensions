{
  "manifest_version": 3,
  "name": "scripting-relative-path",
  "description": "scripting-relative-path",
  "homepage_url": "https://jeurissen.co/webext-demos/scripting-relative-path",
  "author": "Carlos Jeurissen",
  "version": "0.0.1",
  "icons": {
    "16": "icon.png",
    "48": "icon.png"
  },
  "background": {
    "scripts": ["scripts/background.js"],
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_area": "navbar"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://www.example.com/*"]
}
