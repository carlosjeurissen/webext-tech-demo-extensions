{
  "manifest_version": 3,
  "name": "icon-variants-unknown-properties",
  "description": "icon-variants-unknown-properties",
  "homepage_url": "https://jeurissen.co/webext-demos/icon-variants-unknown-properties",
  "author": "Carlos Jeurissen",
  "version": "0.0.2",
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/blue-16.png",
    "48": "icons/blue-48.png"
  },
  "icon_variants": [{
    "16": "icons/red-16.png",
    "48": "icons/red-48.png",
    "unknown_property": ["unknown"]
  }, {
    "16": "icons/yellow-dark-16.png",
    "48": "icons/yellow-dark-48.png",
    "color_schemes": ["dark"]
  }, {
    "16": "icons/yellow-light-16.png",
    "48": "icons/yellow-light-48.png"
  }],
  "action": {
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/blue-16.png",
      "48": "icons/blue-48.png"
    },
    "icon_variants": [{
      "16": "icons/red-16.png",
      "48": "icons/red-48.png",
      "unknown_property": ["unknown"]
    }, {
      "16": "icons/yellow-dark-16.png",
      "48": "icons/yellow-dark-48.png",
      "color_schemes": ["dark"]
    }, {
      "16": "icons/yellow-light-16.png",
      "48": "icons/yellow-light-48.png"
    }]
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html"
  }
}
