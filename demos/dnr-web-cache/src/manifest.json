{
  "manifest_version": 3,
  "name": "dnr-web-cache",
  "description": "dnr-web-cache",
  "homepage_url": "https://jeurissen.co/webext-demos/dnr-web-cache",
  "author": "Carlos Jeurissen",
  "version": "0.0.1",
  "icons": {
    "16": "icon.png",
    "48": "icon.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://developer.mozilla.org/*"
  ],
  "action": {
    "default_area": "navbar"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset",
      "enabled": true,
      "path": "ruleset.json"
    }]
  }
}
